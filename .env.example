# Database Configuration (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
MYSQL_DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/codethon_db?charset=utf8mb4

# Environment
ENVIRONMENT=development
PROJECT_NAME="SkillBridge Intelligence Platform"
VERSION=1.0.0
SECRET_KEY=replace-with-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
